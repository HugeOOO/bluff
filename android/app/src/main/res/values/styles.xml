<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bluff_background</item>
        <item name="colorPrimaryDark">@color/bluff_background</item>
        <item name="colorAccent">@color/bluff_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/bluff_background</item>
        <item name="android:statusBarColor">@color/bluff_background</item>
        <item name="android:windowBackground">@color/bluff_background</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/bluff_splash</item>
        <item name="windowSplashScreenBackground">@color/bluff_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/bluff_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
